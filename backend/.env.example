# Backend Environment Variables Example
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP Mail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@virtualcare.local

# Emergency Numbers (India default: 112 / 108)
EMERGENCY_PHONE_NUMBER=112
AMBULANCE_PHONE_NUMBER=108

# AI Engine
AI_PROVIDER=rules_and_simulated
AI_API_KEY=
